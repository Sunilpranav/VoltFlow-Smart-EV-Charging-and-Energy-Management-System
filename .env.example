# ==============================================================================
# VoltFlow Environment Variables Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env before starting the application:
#    cp .env.example .env
# 2. Never commit .env files containing real secrets to version control.
# 3. For production, generate cryptographically secure random secrets.
# ==============================================================================

# ── MySQL Database Configuration ──────────────────────────────────────────────
# Root password for administrative MySQL database maintenance
MYSQL_ROOT_PASSWORD=replace_with_strong_random_root_password_min_16_chars

# Application database name
MYSQL_DATABASE=voltflow

# Application dedicated database user (least privilege, non-root)
MYSQL_USER=voltflow_user

# Application dedicated database user password
MYSQL_PASSWORD=replace_with_strong_random_user_password_min_16_chars

# Database host and port (default to internal Docker service name "db" and port 3306)
MYSQL_HOST=db
MYSQL_PORT=3306

# ── Security & JWT Configuration ──────────────────────────────────────────────
# Secret key used to sign and verify JSON Web Tokens.
# MUST be at least 32 characters (256 bits).
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars

# JWT token validity in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────────────────────
# Comma-separated list of allowed origins.
# Development default: http://localhost:5173
# Production example: https://voltflow.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# ── Application Runtime Profiles ─────────────────────────────────────────────
# Spring profile: "default" for local dev, "prod" for production
SPRING_PROFILES_ACTIVE=default

# Disable Hibernate SQL logging in production to protect data and improve performance
SHOW_SQL=false

# ── Frontend Configuration ───────────────────────────────────────────────────
# Base URL for API requests.
# For local split deployment: http://localhost:8080/api
# For single-domain / reverse-proxy production deployment: /api
VITE_API_BASE_URL=http://localhost:8080/api

# ── Production Domain & SSL (Used by production reverse proxy) ────────────────
PRODUCTION_DOMAIN=voltflow.yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/live/voltflow.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/live/voltflow.yourdomain.com/privkey.pem
