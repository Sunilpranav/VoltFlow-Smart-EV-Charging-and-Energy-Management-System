# ==============================================================================
# VoltFlow Production Frontend & Gateway Dockerfile
# Multi-stage build producing hardened Nginx container with TLS support
# ==============================================================================

# Build Stage
FROM node:20-alpine AS builder
WORKDIR /app

# Dependency installation
COPY package*.json ./
RUN npm ci

# Source build with production relative API base URL
COPY . ./
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# Production Runtime Stage
FROM nginx:alpine
RUN apk --no-cache add wget openssl

# Copy built SPA artifacts
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production Nginx reverse proxy configuration
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Expose HTTP (80) and HTTPS (443)
EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
